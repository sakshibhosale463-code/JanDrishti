<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--Starting with the .NET 6 SDK, the [Appname].runtimesettings.dev.json file is no longer generated by default at compile time. If you still want this file to be generated, set the GenerateRuntimeConfigDevFile property to true.-->
    <GenerateRuntimeConfigDevFile>true</GenerateRuntimeConfigDevFile>
    <!--Set this parameter to true to get the dlls copied from the NuGet cache to the output of your project-->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <!--When true, compiles and emits the Razor assembly as part of publishing the project-->
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <!-- We copy the entire \App_Data directory. But we ignore JSON files and data protection keys  -->
    <Content Include="App_Data\**" CopyToPublishDirectory="PreserveNewest" Exclude="App_Data\*.json" />
    <Compile Remove="Certificates\**" />
    <Content Remove="Certificates\**" />
    <EmbeddedResource Remove="Certificates\**" />
    <None Remove="Certificates\**" />
    <PackageReference Include="AWSSDK.SQS" Version="3.7.400.133" />
    <PackageReference Include="DinkToPdf" Version="1.0.8" />
    <PackageReference Include="EPPlus" Version="8.0.2" />
    
    <Content Update="App_Data\DataProtectionKeys\*.xml" CopyToPublishDirectory="Never" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Project.Web.Framework\Project.Web.Framework.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="DevExtreme.AspNet.Data">
      <HintPath>..\..\Plugins\DevExtreme\DevExtreme.AspNet.Data.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Area\Factories\" />
    <Folder Include="wwwroot\Logs\" />
  </ItemGroup>

</Project>
